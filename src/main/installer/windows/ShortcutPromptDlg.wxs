<!--
  Pantalla de accesos directos, con un cambio: ya no pregunta por el del menú Inicio.

  Es el ShortcutPromptDlg.wxs de jpackage (JDK 21) sin la casilla del menú Inicio. Esa
  casilla gobernaba la propiedad JP_INSTALL_STARTMENU_SHORTCUT, que jpackage deja valiendo
  1: al quitarla se queda en ese valor y el acceso directo se crea siempre. Es lo que hace
  que la aplicación aparezca al buscarla en Windows, porque el buscador indexa el menú
  Inicio; sin esa entrada queda instalada pero imposible de encontrar si no es por su
  carpeta. El icono del escritorio sí se sigue preguntando, que es lo que de verdad va en
  gustos.

  jpackage no tiene ninguna opción para preguntar solo por uno de los dos: la opción
  win-shortcut-prompt pone las dos casillas o ninguna, y sin ella se crean los dos sin
  preguntar nada.

  El archivo entero se sustituye desde la carpeta de recursos, igual que main.wxs, así que
  conviene compararlo con el de jpackage al subir de JDK.
-->

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">

  <!-- La plantilla original colocaba aquí las dos casillas, una debajo de otra. Con una
       sola, se queda en el sitio de la primera. -->
  <?define JpDesktopShortcutPromptControlY=140 ?>

  <Fragment>
    <UI>
      <Dialog Id="ShortcutPromptDlg" Width="370" Height="270" Title="!(loc.ShortcutPromptDlg_Title)" NoMinimize="yes">
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="!(loc.ShortcutPromptDlgDescription)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="!(loc.ShortcutPromptDlgTitle)" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no"
                 Text="!(loc.ShortcutPromptDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <?ifdef JpDesktopShortcutPrompt ?>
        <Control Type="CheckBox" X="20" Width="200" Height="17" CheckBoxValue="1"
                 Id="InstallDesktopShortcut"
                 Y="$(var.JpDesktopShortcutPromptControlY)"
                 Property="JP_INSTALL_DESKTOP_SHORTCUT"
                 Text="!(loc.ShortcutPromptDlgDesktopShortcutControlLabel)"/>
        <?endif?>

        <!-- Aquí iba la casilla del menú Inicio. Ver el comentario de arriba. -->

        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes"
                 Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes"
                 Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
