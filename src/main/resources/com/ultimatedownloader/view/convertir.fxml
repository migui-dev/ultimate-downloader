<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  Módulo Convertir. Arriba la lista de archivos (se pueden soltar encima), debajo la ficha del
  que esté seleccionado y las opciones de salida, y al final la carpeta de destino.
-->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ultimatedownloader.ui.ConvertirController"
            styleClass="raiz">

    <fx:define>
        <ToggleGroup fx:id="grupoCalidad"/>
    </fx:define>

    <center>
        <ScrollPane fitToWidth="true" styleClass="lienzo">
            <VBox spacing="24" styleClass="columna">
                <padding>
                    <Insets top="4" right="24" bottom="24" left="24"/>
                </padding>

                <!-- Archivos -->
                <VBox spacing="10">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="%convertir.archivos" styleClass="seccion"/>
                        <Label fx:id="etiquetaCuenta" styleClass="texto-3"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="botonAnadir" text="%convertir.anadir_archivos" onAction="#anadir"/>
                        <Button fx:id="botonQuitar" text="%convertir.quitar" onAction="#quitar"/>
                        <Button fx:id="botonLimpiar" text="%convertir.vaciar" onAction="#limpiar"/>
                    </HBox>

                    <VBox fx:id="zonaSoltar" spacing="8">
                        <TableView fx:id="tablaArchivos" prefHeight="200"
                                   styleClass="tabla-formatos">
                            <columns>
                                <TableColumn fx:id="colNombre" text="%comun.archivo" prefWidth="320"/>
                                <TableColumn fx:id="colTipo" text="%convertir.contenido" prefWidth="180"/>
                                <TableColumn fx:id="colDuracion" text="%convertir.duracion" prefWidth="110"/>
                                <TableColumn fx:id="colTamano" text="%comun.tamano" prefWidth="110"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <Label fx:id="etiquetaError" styleClass="mensaje-error" wrapText="true"
                           visible="false" managed="false"/>
                </VBox>

                <!-- Ficha del archivo seleccionado -->
                <VBox fx:id="ficha" styleClass="ficha" spacing="6"
                      visible="false" managed="false">
                    <Label fx:id="fichaNombre" styleClass="titulo-video" wrapText="true"/>
                    <Label fx:id="fichaResumen" styleClass="texto-2"/>
                    <VBox fx:id="fichaPistas" spacing="2"/>
                </VBox>

                <Region styleClass="linea"/>

                <!-- Salida -->
                <VBox spacing="14">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="%convertir.convertir_a" styleClass="seccion"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox styleClass="segmentado" spacing="0">
                            <ToggleButton fx:id="calidadMaxima" text="%comun.maxima"
                                          toggleGroup="$grupoCalidad"/>
                            <ToggleButton fx:id="calidadMedia" text="%comun.media"
                                          toggleGroup="$grupoCalidad" selected="true"/>
                            <ToggleButton fx:id="calidadMinima" text="%comun.minima"
                                          toggleGroup="$grupoCalidad"/>
                        </HBox>
                    </HBox>

                    <GridPane hgap="16" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="150"/>
                            <ColumnConstraints minWidth="240"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="%comun.formato" GridPane.rowIndex="0" GridPane.columnIndex="0"
                               styleClass="texto-2"/>
                        <ComboBox fx:id="comboFormato" GridPane.rowIndex="0"
                                  GridPane.columnIndex="1" maxWidth="Infinity"/>
                        <Label fx:id="etiquetaPerfil" GridPane.rowIndex="0"
                               GridPane.columnIndex="2" styleClass="texto-3" wrapText="true"/>
                    </GridPane>

                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <CheckBox fx:id="casillaRemux"
                                  text="%convertir.copiar_sin_recomprimir_cuando_se"/>
                        <CheckBox fx:id="casillaSoloAudio" text="%convertir.quedarme_solo_con_el_audio"/>
                        <CheckBox fx:id="casillaGpu" text="%convertir.codificar_con_la_gpu"/>
                    </HBox>

                    <Label fx:id="etiquetaRemux" styleClass="texto-3" wrapText="true"/>

                    <VBox fx:id="cajaAvisos" styleClass="aviso" spacing="4"
                          visible="false" managed="false"/>
                </VBox>

                <!-- Opciones avanzadas -->
                <TitledPane fx:id="panelAvanzado" text="%comun.opciones_avanzadas" expanded="false">
                    <VBox spacing="12">
                        <Label fx:id="etiquetaAvanzadoLote" styleClass="texto-3" wrapText="true"
                               text="%convertir.con_varios_archivos_en_la"/>
                        <GridPane hgap="16" vgap="12">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150"/>
                                <ColumnConstraints minWidth="120"/>
                                <ColumnConstraints minWidth="120"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="%comun.resolucion" GridPane.rowIndex="0"
                                   GridPane.columnIndex="0" styleClass="texto-2"/>
                            <TextField fx:id="campoAncho" promptText="%convertir.ancho"
                                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <TextField fx:id="campoAlto" promptText="%convertir.alto"
                                       GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                            <Label text="%convertir.vacio_como_el_original" GridPane.rowIndex="0"
                                   GridPane.columnIndex="3" styleClass="texto-3"/>

                            <Label text="%convertir.fotogramas_por_segundo" GridPane.rowIndex="1"
                                   GridPane.columnIndex="0" styleClass="texto-2"/>
                            <TextField fx:id="campoFps" promptText="%convertir.fps"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="%convertir.frecuencia_de_muestreo" GridPane.rowIndex="2"
                                   GridPane.columnIndex="0" styleClass="texto-2"/>
                            <TextField fx:id="campoFrecuencia" promptText="%convertir.hz"
                                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <TextField fx:id="campoCanales" promptText="%convertir.canales"
                                       GridPane.rowIndex="2" GridPane.columnIndex="2"/>

                            <Label text="%convertir.pista_de_audio" GridPane.rowIndex="3"
                                   GridPane.columnIndex="0" styleClass="texto-2"/>
                            <ComboBox fx:id="comboPistaAudio" GridPane.rowIndex="3"
                                      GridPane.columnIndex="1" GridPane.columnSpan="2"
                                      maxWidth="Infinity"/>

                            <Label text="%convertir.recortar" GridPane.rowIndex="4"
                                   GridPane.columnIndex="0" styleClass="texto-2"/>
                            <TextField fx:id="campoInicio" promptText="%convertir.desde_1_30"
                                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                            <TextField fx:id="campoFin" promptText="%convertir.hasta_2_45"
                                       GridPane.rowIndex="4" GridPane.columnIndex="2"/>
                        </GridPane>
                    </VBox>
                </TitledPane>

                <Region styleClass="linea"/>
                <fx:include fx:id="carpetaDestino" source="carpeta-destino.fxml"/>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <VBox>
            <Region styleClass="linea"/>
            <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="barra-acciones">
                <padding>
                    <Insets top="12" right="24" bottom="12" left="24"/>
                </padding>
                <Label fx:id="etiquetaResumen" styleClass="texto-2" HBox.hgrow="ALWAYS"
                       maxWidth="Infinity"/>
                <Button fx:id="botonConvertir" text="%comun.convertir" onAction="#convertir"
                        styleClass="boton-primario" disable="true"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
