<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.ultimatedownloader.ui.CarpetaDestinoController" spacing="10">
    <Label text="%comun.carpeta_de_destino" styleClass="seccion"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label fx:id="etiquetaCarpeta" styleClass="ruta" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        <MenuButton fx:id="menuRecientes" text="%comun.recientes"/>
        <Button fx:id="botonCambiar" text="%comun.cambiar" onAction="#cambiar"/>
        <Button fx:id="botonAbrir" onAction="#abrir" styleClass="boton-icono">
            <tooltip>
                <Tooltip text="%comun.abrir_la_carpeta"/>
            </tooltip>
        </Button>
    </HBox>
    <Label fx:id="etiquetaEspacio" styleClass="texto-3"/>
</VBox>
